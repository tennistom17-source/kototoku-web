{
  "name": "kototoku-consultation",
  "main": "consultation.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [{ "name": "BUDGET", "class_name": "ConsultationBudget" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ConsultationBudget"] }],
  "vars": {
    "ENABLED": "false",
    "ALLOWED_ORIGIN": "https://tennistom17-source.github.io",
    "FREE_PLAN_VERIFIED": "false",
    "MODERATION_FREE_VERIFIED": "false",
    "APPROVED_MONTH": "",
    "PRICE_VALID_UNTIL": "",
    "MODEL": "gpt-4.1-mini-2025-04-14",
    "INPUT_USD_PER_MILLION": "0.40",
    "OUTPUT_USD_PER_MILLION": "1.60",
    "YEN_PER_USD_WITH_TAX": "198"
  }
}